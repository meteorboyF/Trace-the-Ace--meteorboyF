# ============================================================
# DATA PROTECTION — competition rules prohibit redistribution.
# These patterns MUST stay. Do not loosen without reading COMPETITION.md.
# ============================================================
data/
artifacts/
runs/
# The whole submission/ tree is BUILD OUTPUT derived from competition data
# (model bundles, staged zips, smoke working dirs). Regenerate with
# tasks.run("submission.build"). Never commit any of it.
submission/
*.zip
*.csv
*.parquet
*.pt
*.bin
*.safetensors
*.pth
*.onnx
*.joblib
*.pkl
# Competition data files. These are DATA-file patterns, so they are scoped to data
# extensions rather than bare prefixes.
#
# CAUTION: a bare `test_*` here also matches `tests/test_*.py`. That silently kept every
# test file out of the repo, and CI then collected zero tests and failed with exit code 5
# while every gate passed locally. Keep these extension-scoped.
train_*.csv
train_*.zip
train_*.parquet
test_*.csv
test_*.zip
test_*.parquet
submission_format*
submission.csv

# Belt-and-braces: the data lives in these directories anyway (already ignored above),
# and the pre-commit hook blocks the data patterns independently.
/train_transcripts/
/test_transcripts/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Allow-list: keep small text fixtures & configs that tests need
!tests/fixtures/**
!conf/**/*.yaml
!docs/**/*.md
