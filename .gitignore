submission/
*.zip
*.csv
*.parquet
*.pt
*.bin
*.safetensors
*.pth
*.onnx
*.joblib
*.pkl
train_*
test_*
submission_format*
submission.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

